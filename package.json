  "license": "MIT",
  "author": "dc165015",
  "repository": {
    "type": "git",
    "url": "https://github.com/dc165015/dsh-stock-review.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "stock",
    "a-share",
    "equity-research",
    "skill"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.5"
  },
